{
  "name": "golden-rose-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "npm run configure && tauri dev",
    "desktop:electron": "electron electron-shell",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:windows": "npm run configure && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "prerequisites": "tauri info"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-opener": "2.7.3",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "^45.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
